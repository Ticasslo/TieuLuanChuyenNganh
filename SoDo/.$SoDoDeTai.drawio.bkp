<mxfile host="app.diagrams.net"><diagram id="sododetai" name="Sơ đồ đề tài"><mxGraphModel dx="1500" dy="2088" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="2088" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="SƠ ĐỒ THỰC HIỆN ĐỀ TÀI VÀ CÁC CẢI TIẾN SO VỚI BÀI CƠ SỞ BIASCAST (HESS 2026)" style="text;html=1;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1460" height="32" as="geometry"/></mxCell><mxCell id="t2" value="Bài toán: dự báo qmax (lưu lượng lớn nhất trong ngày) của ngày t cho 451 lưu vực LamaH-CE · Q: lưu lượng quan trắc · hindcast: chuỗi 364 ngày quá khứ · forecast: ngày t (dự báo thời tiết vận hành)&lt;br&gt;Nền tảng tính toán: Kaggle (chính), Google Colab (dự phòng) · Khung mã: NeuralHydrology (bản của nhóm tác giả) · Chia tập: huấn luyện 2003–2009, kiểm định 2010–2013, kiểm tra 2014–2017" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1460" height="36" as="geometry"/></mxCell><mxCell id="secI" value="I. TRÌNH TỰ THỰC HIỆN (tổng cộng khoảng 42 lần huấn luyện)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#999999;fontSize=14;align=left;fontStyle=1;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="82" width="1460" height="150" as="geometry"/></mxCell><mxCell id="s0" value="0. Chuẩn bị dữ liệu&lt;br&gt;Extended LamaH-CE và&lt;br&gt;kết quả của nhóm tác giả" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40.0" y="124" width="158.25" height="88" as="geometry"/></mxCell><mxCell id="s1" value="A. Tái lập bài cơ sở&lt;br&gt;khảo sát dữ liệu, chạy lại&lt;br&gt;mô hình, baseline persistence" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="220.25" y="124" width="158.25" height="88" as="geometry"/></mxCell><mxCell id="s2" value="B. Tầng 1&lt;br&gt;cải tiến mô hình LSTM&lt;br&gt;của bài cơ sở (15 lần)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="400.5" y="124" width="158.25" height="88" as="geometry"/></mxCell><mxCell id="s3" value="C. Tầng 2: thay lõi&lt;br&gt;GRU · Transformer&lt;br&gt;S4D · Mamba&lt;br&gt;(12 lần và tinh chỉnh)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="580.75" y="124" width="158.25" height="88" as="geometry"/></mxCell><mxCell id="s4" value="D–F. Mở rộng (15 lần)&lt;br&gt;D: chuỗi 730 ngày&lt;br&gt;E: Mamba+, Transformer+&lt;br&gt;F: đầu ra xác suất" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="761.0" y="124" width="158.25" height="88" as="geometry"/></mxCell><mxCell id="s5" value="Đánh giá&lt;br&gt;NSE, KGE, sai số đỉnh lũ&lt;br&gt;kịch bản vận hành&lt;br&gt;phân tích theo lưu vực" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="941.25" y="124" width="158.25" height="88" as="geometry"/></mxCell><mxCell id="s6" value="G. Giải thích mô hình&lt;br&gt;ngưỡng nguy cơ lũ&lt;br&gt;ứng dụng minh họa" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1121.5" y="124" width="158.25" height="88" as="geometry"/></mxCell><mxCell id="s7" value="BÁO CÁO&lt;br&gt;TIỂU LUẬN VÀ&lt;br&gt;ỨNG DỤNG MINH HỌA" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;fontStyle=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1301.75" y="124" width="158.25" height="88" as="geometry"/></mxCell><mxCell id="lgt" value="II. KIẾN TRÚC CHI TIẾT — cột trái: thành phần của bài cơ sở (theo mã nguồn); cột phải: thành phần đề tài sửa đổi hoặc thay thế; màu tương ứng với bước ở phần I" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="1460" height="22" as="geometry"/></mxCell><mxCell id="lg0" value="Thành phần của bài cơ sở, giữ nguyên" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="268" width="292" height="26" as="geometry"/></mxCell><mxCell id="lg1" value="A: tái lập bài cơ sở và mốc so sánh" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="342" y="268" width="285" height="26" as="geometry"/></mxCell><mxCell id="lg2" value="B: tầng 1 — cải tiến mô hình LSTM" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="637" y="268" width="271" height="26" as="geometry"/></mxCell><mxCell id="lg3" value="C, D, E: tầng 2 — lõi thời gian, chuỗi dài, biến thể" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="918" y="268" width="404" height="26" as="geometry"/></mxCell><mxCell id="lg4" value="F: đầu ra xác suất" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="166" height="26" as="geometry"/></mxCell><mxCell id="lg5" value="Đánh giá bổ sung" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="216" y="300" width="152" height="26" as="geometry"/></mxCell><mxCell id="lg6" value="G: giải thích mô hình, ngưỡng lũ, ứng dụng" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="378" y="300" width="334" height="26" as="geometry"/></mxCell><mxCell id="h1" value="BÀI CƠ SỞ — Sequential Forecast LSTM có lưu lượng quan trắc" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="660" height="26" as="geometry"/></mxCell><mxCell id="h2" value="ĐỀ TÀI SỬA ĐỔI / THAY THẾ (mũi tên nét đứt)" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="336" width="680" height="26" as="geometry"/></mxCell><mxCell id="band0" value="1. Dữ liệu đầu vào (mỗi mẫu gồm một lưu vực tại một ngày t)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#999999;fontSize=14;align=left;fontStyle=1;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="372" width="1460" height="350" as="geometry"/></mxCell><mxCell id="a0_0" value="Hindcast: 364 ngày × 31 biến tái phân tích&lt;br&gt;(ERA5-Land 21, E-OBS 7, MSWEP 1, GLEAM 2)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="406" width="660" height="66" as="geometry"/></mxCell><mxCell id="o0_0_0" value="D. Mở rộng hindcast lên 730 ngày cho LSTM và Mamba&lt;br&gt;(dữ liệu khí tượng có từ năm 1981)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="406" width="330" height="66" as="geometry"/></mxCell><mxCell id="a0_1" value="Lưu lượng quan trắc quá khứ: qmean 364 ngày&lt;br&gt;chưa thống nhất đơn vị với nhãn; ngày thiếu Q làm mất mẫu" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="484" width="660" height="66" as="geometry"/></mxCell><mxCell id="o0_1_0" value="B2. Thống nhất đơn vị với nhãn (mm/ngày),&lt;br&gt;bổ sung qmax các ngày trước" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="484" width="330" height="66" as="geometry"/></mxCell><mxCell id="o0_1_1" value="B3. Loại bỏ ngẫu nhiên Q khi huấn luyện để&lt;br&gt;mô hình vẫn dự báo được khi thiếu Q" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1130" y="484" width="330" height="66" as="geometry"/></mxCell><mxCell id="a0_2" value="Forecast ngày t: 5 biến dự báo ECMWF HRES&lt;br&gt;(nhiệt độ, điểm sương, bức xạ, lượng mưa, bốc hơi)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="562" width="660" height="66" as="geometry"/></mxCell><mxCell id="a0_3" value="33 thuộc tính tĩnh của lưu vực · Nhãn: qmax ngày t&lt;br&gt;(m³/s chia diện tích lưu vực, đổi sang mm/ngày)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="660" height="66" as="geometry"/></mxCell><mxCell id="band1" value="2. Tiền xử lý và nạp dữ liệu" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#999999;fontSize=14;align=left;fontStyle=1;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="744" width="1460" height="272" as="geometry"/></mxCell><mxCell id="a1_0" value="Chia kỳ: huấn luyện 2003–2009, kiểm định 2010–2013, kiểm tra 2014–2017 (thêm 364 ngày khởi động)&lt;br&gt;Chuẩn hóa z-score từng biến, thống kê tính trên kỳ huấn luyện" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="778" width="660" height="66" as="geometry"/></mxCell><mxCell id="a1_1" value="Lọc mẫu: loại mẫu khi bất kỳ biến nào thiếu tại bất kỳ ngày nào trong 365 ngày;&lt;br&gt;do dự báo ECMWF bắt đầu từ 2003 nên toàn bộ mẫu năm 2003 bị loại" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="856" width="660" height="66" as="geometry"/></mxCell><mxCell id="o1_1_0" value="B1. Sửa quy tắc lọc: chỉ loại mẫu thiếu nhãn&lt;br&gt;hoặc thiếu biến mà mô hình thực sự sử dụng" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="856" width="330" height="66" as="geometry"/></mxCell><mxCell id="a1_2" value="Lô 256 mẫu, trộn ngẫu nhiên giữa các lưu vực" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="934" width="660" height="66" as="geometry"/></mxCell><mxCell id="band2" value="3. Mô hình (khoảng 85 nghìn tham số)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#999999;fontSize=14;align=left;fontStyle=1;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="1038" width="1460" height="272" as="geometry"/></mxCell><mxCell id="a2_0" value="Lớp nhúng tuyến tính: hindcast 32 → 16, forecast 5 → 16,&lt;br&gt;thuộc tính 33 → 16 ghép vào mỗi bước (32 chiều mỗi bước)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1072" width="660" height="66" as="geometry"/></mxCell><mxCell id="o2_0_0" value="B1. Lớp nhúng masked mean: nhúng riêng từng&lt;br&gt;nguồn dữ liệu, lấy trung bình các nguồn hiện có" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="1072" width="330" height="66" as="geometry"/></mxCell><mxCell id="a2_1" value="Lõi thời gian: LSTM 32 → 128&lt;br&gt;xử lý 364 bước hindcast rồi 1 bước forecast,&lt;br&gt;trạng thái ẩn truyền liên tục giữa hai pha" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="660" height="66" as="geometry"/></mxCell><mxCell id="o2_1_0" value="C. Thay lõi LSTM, giữ nguyên các khối khác:&lt;br&gt;GRU, Transformer, S4D, Mamba" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="1150" width="330" height="66" as="geometry"/></mxCell><mxCell id="o2_1_1" value="E. Mamba+: quét hai chiều trên đoạn hindcast&lt;br&gt;Transformer+: chia chuỗi thành đoạn (patch)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1130" y="1150" width="330" height="66" as="geometry"/></mxCell><mxCell id="a2_2" value="Đầu ra: dropout 0,3, lớp tuyến tính 128 → 1&lt;br&gt;→ qmax ngày t" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1228" width="660" height="66" as="geometry"/></mxCell><mxCell id="o2_2_0" value="F. Đầu ra hỗn hợp phân phối (CMAL)&lt;br&gt;→ xác suất vượt ngưỡng lũ" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="1228" width="330" height="66" as="geometry"/></mxCell><mxCell id="band3" value="4. Huấn luyện" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#999999;fontSize=14;align=left;fontStyle=1;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="1332" width="1460" height="272" as="geometry"/></mxCell><mxCell id="a3_0" value="Hàm mất mát NSE*: trung bình (ŷ − y)² / (σ của lưu vực + 0,1)²" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1366" width="660" height="66" as="geometry"/></mxCell><mxCell id="a3_1" value="Adam, tốc độ học 10⁻³, cosine annealing, tối đa 30 epoch; dừng sớm theo&lt;br&gt;trung vị NSE kiểm định (5 epoch liên tiếp không tăng quá 0,005)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1444" width="660" height="66" as="geometry"/></mxCell><mxCell id="o3_1_0" value="Điều chỉnh bắt buộc để tái lập: tiêu chí lưu mô hình tốt&lt;br&gt;nhất, đường dẫn cấu hình, danh sách 451 lưu vực" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="1444" width="330" height="66" as="geometry"/></mxCell><mxCell id="a3_2" value="Một hạt giống ngẫu nhiên; mọi cấu hình dùng chung&lt;br&gt;số chiều ẩn 128, lô 256, dropout 0,3" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1522" width="660" height="66" as="geometry"/></mxCell><mxCell id="o3_2_0" value="B4. Ba hạt giống mỗi cấu hình; báo cáo trung&lt;br&gt;bình (tổ hợp) và độ lệch chuẩn" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="1522" width="330" height="66" as="geometry"/></mxCell><mxCell id="o3_2_1" value="C. Tinh chỉnh số chiều ẩn 64 / 128 / 256&lt;br&gt;với cùng ngân sách cho mọi lõi" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1130" y="1522" width="330" height="66" as="geometry"/></mxCell><mxCell id="band4" value="5. Đánh giá và sản phẩm" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#999999;fontSize=14;align=left;fontStyle=1;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="1626" width="1460" height="350" as="geometry"/></mxCell><mxCell id="a4_0" value="Kiểm tra 2014–2017: NSE, KGE theo từng lưu vực, đường CDF&lt;br&gt;(mô hình tốt nhất đạt NSE trung vị 0,705)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1660" width="660" height="66" as="geometry"/></mxCell><mxCell id="o4_0_0" value="A. Baseline persistence: dùng lưu lượng ngày&lt;br&gt;trước làm dự báo (NSE trung vị 0,35–0,37)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="1660" width="330" height="66" as="geometry"/></mxCell><mxCell id="o4_0_1" value="Sai số đỉnh lũ (FHV)&lt;br&gt;và độ lệch thời điểm đỉnh" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1130" y="1660" width="330" height="66" as="geometry"/></mxCell><mxCell id="a4_1" value="Mốc so sánh: mô hình chỉ dùng dự báo thời tiết (0,387),&lt;br&gt;mô hình dùng tái phân tích (khoảng 0,69)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1738" width="660" height="66" as="geometry"/></mxCell><mxCell id="o4_1_0" value="Kịch bản vận hành: thiếu Q 1–7 ngày gần nhất;&lt;br&gt;tái phân tích trễ 5 ngày (độ trễ công bố của ERA5)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="1738" width="330" height="66" as="geometry"/></mxCell><mxCell id="a4_2" value="ΔNSE theo lưu vực so với baseline, tương quan với 33 thuộc tính,&lt;br&gt;khoảng cách Wasserstein giữa tái phân tích và dự báo" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1816" width="660" height="66" as="geometry"/></mxCell><mxCell id="o4_2_0" value="Phân tích theo lưu vực: ΔNSE giữa Mamba và&lt;br&gt;LSTM, tương quan với thuộc tính lưu vực" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="1816" width="330" height="66" as="geometry"/></mxCell><mxCell id="a4_3" value="Không có phần giải thích mô hình, ngưỡng nguy cơ lũ và ứng dụng" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1894" width="660" height="66" as="geometry"/></mxCell><mxCell id="o4_3_0" value="G. Giải thích mô hình (Integrated Gradients) · ngưỡng nguy cơ lũ theo&lt;br&gt;chu kỳ lặp lại · ứng dụng bản đồ dự báo 451 lưu vực" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="1894" width="680" height="66" as="geometry"/></mxCell><mxCell id="cut" value="Thứ tự ưu tiên lược bỏ khi không đủ thời gian: (1) giải thích mô hình ở bước G,&lt;br&gt;(2) biến thể cải tiến ở bước E, (3) chuỗi 730 ngày ở bước D. Các bước B, C, đánh giá và ứng dụng giữ nguyên." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="1998" width="720.0" height="70" as="geometry"/></mxCell><mxCell id="kl" value="Hướng phát triển trong khóa luận: kết hợp dữ liệu theo giờ, dự báo nhiều ngày, hàm mất mát ưu tiên đỉnh lũ,&lt;br&gt;đồ thị mạng lưới sông, mô hình lai (Mamba kết hợp attention, LOAN), xLSTM, phần mềm ứng dụng" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="760.0" y="1998" width="720.0" height="70" as="geometry"/></mxCell><mxCell id="e0" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;strokeWidth=1.8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;strokeWidth=1.8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;strokeWidth=1.8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;strokeWidth=1.8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;strokeWidth=1.8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="endArrow=block;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;strokeWidth=1.8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" st